# Supabase (replace with your own)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin email (the only account that gets admin privileges)
ADMIN_EMAIL=admin@example.com

# Public site URL (used for SEO + sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Gold API sources (free, no key required)
GOLD_API_URL=https://www.gold-api.com/api
EXCHANGE_API_URL=https://open.er-api.com/v6

# Optional: News RSS feeds (comma-separated)
NEWS_RSS_FEEDS=https://www.reutersagency.com/feed/?best-topics=commodities&post_type=gold
